{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "setpiece": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": ["src/styles.scss"],
            "outputPath": "dist",
            "assets": [{"glob":"**/*","input":"public","output":"/"}]
          },
          "configurations": {
            "production": {
              "optimization": { "scripts": true, "styles": {"minify":true,"inlineCritical":false}, "fonts": false },
              "outputHashing": "all",
              "fileReplacements": [{ "replace": "src/dev/mock.ts", "with": "src/dev/mock.prod.ts" }]
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "assets": [
                {"glob":"**/*","input":"public","output":"/"},
                {"glob":"*.png","input":"dev-assets","output":"/dev-assets/Wallpapers"}
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "setpiece:build:development" }
        }
      }
    }
  }
}
